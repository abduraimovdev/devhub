# ─────────────────────────────────────────────────────────────────────────
# devhub konfiguratsiyasi. Bu faylni `.env` ga nusxalab to'ldiring (lokal dev).
# Railway'da bu qiymatlar Service > Variables ichiga qo'yiladi (.env emas).
# `.env` HECH QACHON commit qilinmaydi (.gitignore'da).
# ─────────────────────────────────────────────────────────────────────────

# ── Telegram ──
# @BotFather'dan olingan bot tokeni (alohida "Dev Log" boti).
BOT_TOKEN=123456789:AA-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# "Dev Log" forum guruhi id (manfiy, -100 bilan boshlanadi).
LOG_GROUP_CHAT_ID=-1001234567890

# ── Registr DB (shu servisning O'Z Postgres'i — loyihalar/topiclar jadvali) ──
REGISTRY_DATABASE_URL=postgresql://user:pass@host:5432/devhub

# ── Cloudflare R2 (backup > 50MB yoki Telegram yuborolmaganda) ──
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=devhub-backups
# R2 public/custom domen (link shu yerdan yasaladi). Bo'sh bo'lsa presigned URL.
R2_PUBLIC_BASE_URL=

# ── Log ingest web servisi (Vazifa A) ──
PORT=8080
INGEST_TIMEOUT_SECONDS=10

# ── Backup (Vazifa B) ──
BACKUP_MAX_TELEGRAM_MB=50
PG_DUMP_TIMEOUT_SECONDS=600
# IN-PROCESS backup: ingest servisi ichida shu UTC soatlarda backup ishlaydi
# (alohida cron servis SHART EMAS). Bo'sh = o'chiq. "0,17" = 05:00/22:00 Toshkent.
BACKUP_CRON_HOURS_UTC=
