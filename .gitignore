# Dart
.dart_tool/
build/
.packages

# Flutter (generatsiya — devlog_client sub-paketi)
.flutter-plugins
.flutter-plugins-dependencies

# Secrets / config — barcha .env* ignored, FAQAT namuna ochiq qoladi.
# Sirlar (token, parol, DB URL, R2 kalit) HECH QACHON repo'ga tushmaydi —
# ular Railway Variables yoki lokal `.env` orqali beriladi (.env.example ga qarang).
.env
.env.*
!.env.example
# Kalit / sertifikat / hisob ma'lumotlari (xavfsizlik — public repo)
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
passwords*.yaml
secrets*.yaml
*credentials*.json
service-account*.json

# Backup artefaktlari (hech qachon repo'ga tushmasin)
*.sql
*.sql.gz
*.dump
backups/

# Loglar
*.log

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.idea/
.vscode/
*.iml

# pubspec.lock — bu APPLICATION (paket emas), shuning uchun lock'ni
# COMMIT qilamiz (ignore qilinmaydi).

# Hujjatlar — FAQAT lokal. Public GitHub'ga faqat KOD ketadi; README/CLAUDE/
# docs/tasks kabi .md hujjatlar yuklanmaydi (lokal ishlash uchun saqlanadi).
*.md
docs/
tasks/
